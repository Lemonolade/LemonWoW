+bool AmigoCommandScript::HandleMoveTo(ChatHandler* handler, Optional<float> x, Optional<float> y, Optional<float> z)
+{
+    Player* bot = nullptr;
+    for (auto const& entry : ObjectAccessor::GetPlayers())
+    {
+        Player* candidate = entry.second;
+        if (candidate && candidate->IsInWorld() &&
+            IsAmigoBotNameAllowed(g_OllamaBotControlBotName, candidate->GetName()) &&
+            sPlayerbotsMgr.GetPlayerbotAI(candidate))
+        {
+            bot = candidate;
+            break;
+        }
+    }
+    if (!bot)
+    {
+        handler->SendSysMessage("Amigo moveto: the configured bot is not online.");
+        return true;
+    }
+
+    float targetX = 0.0f;
+    float targetY = 0.0f;
+    float targetZ = 0.0f;
+    if (x && y && z)
+    {
+        targetX = *x;
+        targetY = *y;
+        targetZ = *z;
+    }
+    else if (!x && !y && !z)
+    {
+        Player* requester = handler->GetPlayer();
+        if (!requester || requester->GetMapId() != bot->GetMapId())
+        {
+            handler->SendSysMessage("Amigo moveto: you must be on the same map as the bot to use your position.");
+            return true;
+        }
+        targetX = requester->GetPositionX();
+        targetY = requester->GetPositionY();
+        targetZ = requester->GetPositionZ();
+    }
+    else
+    {
+        handler->SendSysMessage("Usage: .amigo moveto [x y z]  (no arguments = your position)");
+        return true;
+    }
+
+    // A manual move must not be pulled back by companion following.
+    AmigoCompanionRequestPause(bot->GetGUID().GetRawValue(), true);
+
+    BotControlCommand command;
+    command.type = BotControlCommandType::MoveHop;
+    command.targetX = targetX;
+    command.targetY = targetY;
+    command.targetZ = targetZ;
+    command.distance = bot->GetDistance(targetX, targetY, targetZ);
+
+    if (HandleBotControlCommandTracked(bot, command))
+        handler->SendSysMessage(fmt::format("Amigo moveto: {} is moving to ({:.1f}, {:.1f}, {:.1f}), {:.0f} yd away. Companion following paused; say \"follow me\" to resume.",
+            bot->GetName(), targetX, targetY, targetZ, command.distance));
+    else
+        handler->SendSysMessage(fmt::format("Amigo moveto: {} could not start that move. Check Server.log for the reason (combat, unreachable, or travel already active).",
+            bot->GetName()));
     return true;
 }
 
