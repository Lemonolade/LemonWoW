+void AmigoGroupAuthorityScript::StopCompanion(Player* bot, PlayerbotAI* ai, char const* reason)
+{
+    if (!companionBotGuid_)
+        return;
+
+    if (bot && ai && ai->HasStrategy("follow", BOT_STATE_NON_COMBAT))
+        ai->ChangeStrategy("-follow", BOT_STATE_NON_COMBAT);
+
+    AmigoCompanionClear(companionBotGuid_);
+    LOG_INFO("server.loading", "[OllamaBotAmigo] Companion mode stopped: bot_guid={} reason={}",
+             companionBotGuid_, reason ? reason : "unknown");
+
+    companionBotGuid_ = 0;
+    companionTargetGuid_ = 0;
+    companionPaused_ = false;
+    companionFollowing_ = false;
+    targetPosValid_ = false;
+    leashPullUntilMs_ = 0;
+    questRefreshMs_ = 0;
+    targetQuests_.clear();
+}
+
+bool AmigoGroupAuthorityScript::UpdateCompanion(Player* bot, PlayerbotAI* ai, uint32 nowMs)
+{
+    const uint64 botGuid = bot->GetGUID().GetRawValue();
+    Player* target = FindCompanionTarget(bot);
+    if (!target)
+    {
+        StopCompanion(bot, ai, "no_companion_in_group");
+        return false;
+    }
+
+    const uint64 targetGuid = target->GetGUID().GetRawValue();
+    if (companionBotGuid_ != botGuid || companionTargetGuid_ != targetGuid)
+    {
+        StopCompanion(bot, ai, "companion_changed");
+        if (activeBotGuid_)
+            ClearDirective(false, "companion_started");
+        AmigoMindClearPeerDirective(botGuid);
+
+        companionBotGuid_ = botGuid;
+        companionTargetGuid_ = targetGuid;
+        companionFollowing_ = true;
+        targetLastMoveMs_ = nowMs;
+        LOG_INFO("server.loading", "[OllamaBotAmigo] Companion mode started: {} is adventuring with {} (leash {} yd, idle {} ms)",
+                 bot->GetName(), target->GetName(), g_AmigoCompanionLeashYards, g_AmigoCompanionIdleMs);
+    }
+
+    // Playerbots expects a master while grouped. Keeping it on the companion
+    // stops its re-election loop and lets quest sharing reach the bot.
+    if (ai->GetMaster() != target)
+        ai->SetMaster(target);
+
+    // "follow me" / "wait" from the companion (captured silently by AmigoSocial).
+    AmigoBotMindSnapshot mind = AmigoMindSnapshot(botGuid);
+    AmigoSocialIntent const& intent = mind.pendingIntent;
+    if (intent.id && !intent.acknowledged)
+    {
+        if (intent.kind == AmigoSocialIntentKind::RequestFollow && intent.sourceGuid == targetGuid)
+        {
+            companionPaused_ = false;
+            leashPullUntilMs_ = 0;
+            AmigoMindAcknowledgeIntent(botGuid, intent.id);
+            LOG_INFO("server.loading", "[OllamaBotAmigo] Companion: {} resumes following {}", bot->GetName(), target->GetName());
+        }
+        else if (intent.kind == AmigoSocialIntentKind::RequestStop && intent.sourceGuid == targetGuid)
+        {
+            companionPaused_ = true;
+            AmigoMindAcknowledgeIntent(botGuid, intent.id);
+            LOG_INFO("server.loading", "[OllamaBotAmigo] Companion: {} waits here at {}'s request", bot->GetName(), target->GetName());
+        }
+    }
+
+    bool requestedPause = false;
+    if (AmigoCompanionTakePauseRequest(botGuid, requestedPause))
+        companionPaused_ = requestedPause;
+
+    // Track whether the companion is on the move.
+    if (!targetPosValid_ || target->GetMapId() != targetLastMap_ ||
+        target->GetExactDist(targetLastX_, targetLastY_, targetLastZ_) > kCompanionMovedYards)
+    {
+        if (targetPosValid_)
+            targetLastMoveMs_ = nowMs;
+        targetPosValid_ = true;
+        targetLastMap_ = target->GetMapId();
+        targetLastX_ = target->GetPositionX();
+        targetLastY_ = target->GetPositionY();
+        targetLastZ_ = target->GetPositionZ();
+    }
+    if (target->isMoving())
+        targetLastMoveMs_ = nowMs;
+
+    const bool targetIdle = nowMs - targetLastMoveMs_ >= g_AmigoCompanionIdleMs;
+    const bool sameMap = bot->GetMapId() == target->GetMapId() && bot->GetInstanceId() == target->GetInstanceId();
+    const bool beyondLeash = !sameMap || bot->GetDistance(target) > g_AmigoCompanionLeashYards;
+
+    bool wantFollow = false;
+    if (companionPaused_)
+        wantFollow = false;
+    else if (beyondLeash)
+    {
+        if (!companionFollowing_)
+        {
+            leashPullUntilMs_ = nowMs + kCompanionLeashPullCooldownMs;
+            LOG_INFO("server.loading", "[OllamaBotAmigo] Companion: {} went beyond the {} yd leash; returning to {}",
+                     bot->GetName(), g_AmigoCompanionLeashYards, target->GetName());
+        }
+        wantFollow = true;
+    }
+    else if (!targetIdle || nowMs < leashPullUntilMs_)
+        wantFollow = true;
+
+    if (wantFollow)
+    {
+        if (!companionFollowing_)
+            AbortAmigoTravel(botGuid, nowMs);
+        if (ai->HasStrategy("stay", BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("-stay", BOT_STATE_NON_COMBAT);
+        if (!ai->HasStrategy("follow", BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("+follow", BOT_STATE_NON_COMBAT);
+    }
+    else if (ai->HasStrategy("follow", BOT_STATE_NON_COMBAT))
+    {
+        ai->ChangeStrategy("-follow", BOT_STATE_NON_COMBAT);
+    }
+
+    if (g_EnableOllamaBotAmigoDebug && wantFollow != companionFollowing_)
+        LOG_INFO("server.loading", "[OllamaBotAmigo] Companion: {} now {}", bot->GetName(),
+                 wantFollow ? "following" : (companionPaused_ ? "waiting (acting alone)" : "acting alone near companion"));
+    companionFollowing_ = wantFollow;
+
+    if (nowMs >= questRefreshMs_)
+    {
+        questRefreshMs_ = nowMs + kCompanionQuestRefreshMs;
+        targetQuests_.clear();
